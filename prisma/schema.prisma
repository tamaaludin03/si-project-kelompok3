generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pegawai {
  id                   Int       @id @default(autoincrement())
  nip                  String    @unique @db.VarChar(50)
  username             String?   @unique
  nama                 String?
  jabatan              String?
  password             String?
  must_change_password Boolean?  @default(true)
  role                 String?   @default("pegawai") @db.VarChar(20)
  tanggal_lahir        DateTime? @db.Date
  failedLoginAttempts  Int       @default(0)
  cuti                 Cuti[]
  izin                 Izin[]
  email                String?
  no_hp                String?


  @@map("pegawai")
}

model Cuti {
  id              Int       @id @default(autoincrement())
  pegawaiId       Int       @map("pegawai_id")
  jenis_cuti      String    @db.VarChar(50)
  tanggal_mulai   DateTime  @db.Date
  tanggal_selesai DateTime  @db.Date
  alasan          String?
  status          String?   @default("pending") @db.VarChar(20)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  pegawai         Pegawai   @relation(fields: [pegawaiId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("cuti")
}

model Izin {
  id          Int       @id @default(autoincrement())
  pegawaiId   Int       @map("pegawai_id")
  jenis_izin  String    @db.VarChar(50)
  tanggal     DateTime  @db.Date
  jam_mulai   String?   @db.VarChar(10)
  jam_selesai String?   @db.VarChar(10)
  alasan      String?
  status      String?   @default("pending") @db.VarChar(20)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  pegawai     Pegawai   @relation(fields: [pegawaiId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("izin")
}
